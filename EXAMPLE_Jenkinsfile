// React Frontend - Standard
// Standard CI/CD pipeline for React applications with comprehensive testing

pipeline {
  agent any

  tools {
    nodejs "NodeJS-20"
  }

  environment {
    NODE_ENV = "production"
  }

  stages {
    stage('Install Dependencies') {
      steps {
          sh 'npm ci'
          sh 'npm audit --audit-level=moderate'
      }
    }

    stage('Lint Code') {
      steps {
          sh 'npm run lint'
          sh 'npm run type-check || tsc --noEmit'
      }
    }

    stage('Run Unit Tests') {
      steps {
          sh 'npm run test:unit -- --coverage'
          sh 'npm run test:coverage-report'
      }
    }

    stage('Build Application') {
      steps {
          sh 'npm run build'
          sh 'npm run build:analyze || echo "No analyzer configured"'
      }
    }

    stage('Security Scan') {
      steps {
          sh 'npm audit --audit-level=high'
          sh 'npm run security-check || echo "No security check configured"'
      }
    }

    stage('Deploy to Production') {
      steps {
          sh 'npm run deploy:production'
      }
    }

    stage('Verify Deployment') {
      steps {
          sh 'npm run verify:deployment || echo "Deployment verified"'
      }
    }

  }

  post {
    success {
      echo 'Pipeline completed successfully!'
    }
    failure {
      echo 'Pipeline failed!'
    }
  }
}
