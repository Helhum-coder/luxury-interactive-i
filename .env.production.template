# Production Environment Variables Template
# Copy this file to .env.production and fill in your values

# Application Settings
NODE_ENV=production
APP_ENV=production
VITE_APP_TITLE="Luxury Interactive"
VITE_APP_DESCRIPTION="Premium interactive web application"

# GitHub Configuration
VITE_GITHUB_CLIENT_ID=your_github_client_id_here
VITE_GITHUB_CALLBACK_URL=https://your-domain.com/auth/callback

# API Endpoints
VITE_API_BASE_URL=https://api.your-domain.com
VITE_API_VERSION=v1

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_DEBUG_TOOLS=false

# Third-party Services (only include public keys here)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
VITE_SENTRY_DSN=https://...@sentry.io/...

# Build Configuration
VITE_BUILD_TARGET=production
VITE_SOURCE_MAPS=false

# CDN and Assets
VITE_CDN_URL=https://cdn.your-domain.com
VITE_ASSETS_URL=https://assets.your-domain.com