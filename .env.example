# Multi-Platform Environment Variables Template

# =============================================================================
# TEAM CONFIGURATION
# =============================================================================
HELHUM_EMAIL=helhum@hotmail.com
HELHUM_GITHUB=Helhum-coder
HELBS_EMAIL=helbslozroj@gmail.com
HELBS_GITHUB=HelbsLozroj

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_ENV=development
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api
ALLOWED_ORIGINS=*

# =============================================================================
# SECURITY & AUTHENTICATION (Keep these secret!)
# =============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
NEXTAUTH_SECRET=your-nextauth-secret-key
NEXTAUTH_URL=http://localhost:3000

# =============================================================================
# API CREDENTIALS (SENSITIVE - DO NOT COMMIT)
# =============================================================================
GITHUB_TOKEN=ghp_your_github_personal_access_token
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
LINEAR_API_KEY=lin_api_your_linear_api_key
OPENAI_API_KEY=sk-your_openai_api_key
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=postgresql://username:password@localhost:5432/database
DATABASE_SSL=true
REDIS_URL=redis://localhost:6379

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
SENDGRID_API_KEY=SG.your_sendgrid_api_key

# =============================================================================
# CLOUD STORAGE
# =============================================================================
AWS_ACCESS_KEY_ID=AKIA_your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=your-s3-bucket-name
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# =============================================================================
# MONITORING & ANALYTICS
# =============================================================================
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project
ANALYTICS_ID=your_google_analytics_id
MIXPANEL_TOKEN=your_mixpanel_project_token

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_ANALYTICS=true
ENABLE_MONITORING=true
ENABLE_CACHE=true

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
CORS_ORIGIN=*
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000

# =============================================================================
# DEPLOYMENT PLATFORM (automatically set by CI/CD)
# =============================================================================
DEPLOYMENT_PLATFORM=vercel