# Development Environment Variables Template
# Copy this file to .env.local for development

# Application Settings
NODE_ENV=development
APP_ENV=development
VITE_APP_TITLE="Luxury Interactive (Dev)"
VITE_APP_DESCRIPTION="Development environment for luxury interactive app"

# GitHub Configuration (Development)
VITE_GITHUB_CLIENT_ID=your_dev_github_client_id_here
VITE_GITHUB_CALLBACK_URL=http://localhost:5173/auth/callback

# API Endpoints (Development)
VITE_API_BASE_URL=http://localhost:3001
VITE_API_VERSION=v1

# Feature Flags (Development)
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_REPORTING=false
VITE_ENABLE_DEBUG_TOOLS=true

# Third-party Services (Test/Development keys)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
VITE_SENTRY_DSN=https://...@sentry.io/...

# Build Configuration (Development)
VITE_BUILD_TARGET=development
VITE_SOURCE_MAPS=true

# Local Development
VITE_HOT_RELOAD=true
VITE_MOCK_API=false